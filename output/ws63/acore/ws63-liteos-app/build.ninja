# =============================================================================
# Link build statements for STATIC_LIBRARY target dma


#############################################
# Link the static library driver\dma\libdma.a

build driver/dma/libdma.a: C_STATIC_LIBRARY_LINKER__dma_ driver/dma/CMakeFiles/dma.dir/dma.c.obj
  OBJECT_DIR = driver\dma\CMakeFiles\dma.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = driver\dma\libdma.a
  TARGET_PDB = dma.a.dbg


#############################################
# Utility command for edit_cache

build driver/dma/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D C:\ws63src\output\ws63\acore\ws63-liteos-app\driver\dma && C:\Users\13716\AppData\Local\Programs\Python\Python311\Lib\site-packages\cmake\data\bin\cmake-gui.exe -SC:\ws63src -BC:\ws63src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build driver/dma/edit_cache: phony driver/dma/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build driver/dma/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D C:\ws63src\output\ws63\acore\ws63-liteos-app\driver\dma && C:\Users\13716\AppData\Local\Programs\Python\Python311\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\ws63src -BC:\ws63src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build driver/dma/rebuild_cache: phony driver/dma/CMakeFiles/rebuild_cache.util

