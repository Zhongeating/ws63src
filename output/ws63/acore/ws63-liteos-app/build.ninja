  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = hal\pmp\libhal_pmp.a
  TARGET_PDB = hal_pmp.a.dbg


#############################################
# Utility command for rebuild_cache

build hal/pmp/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cmd.exe /C "cd /D C:\ws63src\output\ws63\acore\ws63-liteos-app\hal\pmp && C:\Users\13716\AppData\Local\Programs\Python\Python311\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\ws63src -BC:\ws63src\output\ws63\acore\ws63-liteos-app"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build hal/pmp/rebuild_cache: phony hal/pmp/CMakeFiles/rebuild_cache.util

# =============================================================================
# Write statements declared in CMakeLists.txt:
# C:/ws63src/drivers/drivers/hal/CMakeLists.txt
# =============================================================================

