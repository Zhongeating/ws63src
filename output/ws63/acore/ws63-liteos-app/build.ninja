  COMMAND = cmd.exe /C "cd /D C:\ws63src\output\ws63\acore\ws63-liteos-app\drivers\chips\ws63\porting\gpio && C:\Users\13716\AppData\Local\Programs\Python\Python311\Lib\site-packages\cmake\data\bin\cmake.exe --regenerate-during-build -SC:\ws63src -BC:\ws63src\output\ws63\acore\ws63-liteos-app"
